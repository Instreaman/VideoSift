{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videosift.local/contracts/v0.1/rpc.schema.json",
  "title": "VideoSift JSON-RPC profile draft 0.1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Notification"
    },
    {
      "$ref": "#/$defs/SuccessResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    }
  ],
  "$defs": {
    "HandshakeParams": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "task_id": {
          "type": "null"
        },
        "client_name": {
          "enum": [
            "desktop",
            "cli",
            "core",
            "worker"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*(?![\\s\\S])",
            "maxLength": 128
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "protocol_version",
        "task_id",
        "client_name",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "HandshakeResult": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "task_id": {
          "type": "null"
        },
        "server_name": {
          "enum": [
            "desktop",
            "cli",
            "core",
            "worker"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*(?![\\s\\S])",
            "maxLength": 128
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "protocol_version",
        "task_id",
        "server_name",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "TaskParams": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
        }
      },
      "required": [
        "protocol_version",
        "task_id"
      ],
      "additionalProperties": false
    },
    "TranscribeParams": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
        },
        "audio": {
          "$ref": "https://videosift.local/contracts/v0.1/domain.schema.json#/$defs/FileReference"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        }
      },
      "required": [
        "protocol_version",
        "task_id",
        "audio",
        "language"
      ],
      "additionalProperties": false
    },
    "ProgressParams": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
        },
        "stage": {
          "enum": [
            "resolve",
            "metadata",
            "subtitle",
            "audio",
            "asr",
            "keyframe",
            "ocr",
            "align",
            "summarize",
            "validate",
            "export"
          ]
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocol_version",
        "task_id",
        "stage",
        "completed",
        "total"
      ],
      "additionalProperties": false
    },
    "ExitingParams": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "protocol_version",
        "task_id",
        "exit_code"
      ],
      "additionalProperties": false
    },
