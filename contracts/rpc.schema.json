        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "const": -32700
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "type": "null"
              }
            }
          }
        }
      ]
