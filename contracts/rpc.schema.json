    "Request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
            },
            "method": {
              "const": "system.handshake"
            },
            "params": {
              "$ref": "#/$defs/HandshakeParams"
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ],
          "additionalProperties": false
